FROM node:24.14.0-bookworm-slim AS ui-build

WORKDIR /app
COPY . .
WORKDIR /app/mlflow/server/js
RUN node yarn/releases/yarn-4.12.0.cjs install --immutable \
    && node yarn/releases/yarn-4.12.0.cjs build

FROM python:3.12-slim-bookworm

WORKDIR /app
COPY . .
COPY --from=ui-build /app/mlflow/server/js/build /app/mlflow/server/js/build

RUN python -m pip install --no-cache-dir -e ".[auth,db]"

ENV MLFLOW_AUTH_CONFIG_PATH=/app/mlflow/server/auth/keycloak_auth.ini \
    MLFLOW_BACKEND_STORE_URI=sqlite:////data/mlflow.db \
    MLFLOW_AUTH_DATABASE_URI=sqlite:////data/keycloak_auth.db \
    MLFLOW_ARTIFACTS_DESTINATION=/data/artifacts

EXPOSE 5000

CMD ["python", "-m", "mlflow", "server", "--app-name", "basic-auth", "--host", "0.0.0.0", "--port", "5000"]
